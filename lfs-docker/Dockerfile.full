# Full LFS 12.2 Build Environment
# Builds all standard LFS packages from source for shitix kernel
FROM alpine:3.19 AS builder

# ---- Build arguments for parallelism ----
ARG JOBS=1
ENV JOBS=$JOBS
ENV MAKEFLAGS="-j$JOBS"

# ---- Mirror Configuration (LFS §3.1) ----
# Default: Chinese mirrors (Tsinghua + Aliyun)
# Override with --build-arg REGION=us|eu|default
ARG REGION=cn
COPY scripts/full/mirrors.sh /tmp/mirrors.sh
RUN source /tmp/mirrors.sh "$REGION" && \
    echo "$ALPINE_MAIN" > /etc/apk/repositories && \
    echo "$ALPINE_COMMUNITY" >> /etc/apk/repositories && \
    echo "LFS_MIRROR=$LFS_MIRROR" >> /etc/environment && \
    echo "GNU_MIRROR=$GNU_MIRROR" >> /etc/environment && \
    echo "KERNEL_MIRROR=$KERNEL_MIRROR" >> /etc/environment

# LFS source mirrors (available to build scripts)
ENV LFS_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/lfs/lfs-packages/12.2"
ENV GNU_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/gnu"
ENV KERNEL_MIRROR="https://mirrors.tuna.tsinghua.edu.cn/kernel"

# LFS build dependencies (Chapter 2)
RUN apk add --no-cache \
    bash binutils bison coreutils diffutils file findutils gawk \
    gcc g++ grep gzip make patch perl python3 sed tar texinfo xz \
    musl-dev linux-headers m4 flex bzip2 wget curl ca-certificates \
    zlib-dev openssl-dev readline-dev ncurses-dev \
    autoconf automake libtool pkgconfig gettext gettext-dev \
    groff less shadow dbus-dev libcap-dev elfutils-dev \
    expat expat-dev \
    zstd-dev lz4-dev \
    kmod libcap-utils rsync cpio meson ninja \
    gmp-dev mpfr-dev mpc1-dev isl-dev \
    python3-dev py3-pip py3-setuptools py3-jinja2 py3-markupsafe \
    tcl expect dejagnu \
    bc gperf libpipeline-dev intltool kmod-dev dbus \
    linux-pam-dev e2fsprogs e2fsprogs-dev

ENV LFS=/lfs
ENV LC_ALL=POSIX
ENV PATH=/usr/bin:/bin

WORKDIR /lfs

# Create LFS directory structure
RUN mkdir -pv $LFS/boot $LFS/dev $LFS/etc $LFS/home \
    $LFS/media $LFS/mnt $LFS/opt $LFS/proc \
    $LFS/root $LFS/run $LFS/srv $LFS/sys $LFS/tmp \
    $LFS/usr $LFS/var && \
    mkdir -pv $LFS/usr/bin $LFS/usr/include $LFS/usr/lib \
    $LFS/usr/libexec $LFS/usr/sbin $LFS/usr/share $LFS/usr/src && \
    mkdir -pv $LFS/usr/share/doc $LFS/usr/share/info $LFS/usr/share/locale \
    $LFS/usr/share/man $LFS/usr/share/misc $LFS/usr/share/terminfo \
    $LFS/usr/share/zoneinfo && \
    mkdir -pv $LFS/var/cache $LFS/var/lib $LFS/var/local $LFS/var/lock \
    $LFS/var/log $LFS/var/mail $LFS/var/opt $LFS/var/run \
    $LFS/var/spool $LFS/var/tmp && \
    chmod 1777 $LFS/tmp $LFS/var/tmp && \
    ln -sv usr/bin $LFS/bin && ln -sv usr/lib $LFS/lib && \
    ln -sv usr/lib $LFS/lib64 && ln -sv usr/sbin $LFS/sbin

# Install musl headers and libc as the target system's libc
RUN rsync -a --progress /usr/include $LFS/usr/ && \
    rsync -a --progress /lib/ld-musl-x86_64.so.1 $LFS/lib/ && \
    rsync -a --progress /lib/libc.musl-x86_64.so.1 $LFS/lib/ && \
    rsync -a --progress /usr/lib/libc.a $LFS/usr/lib/ && \
    rsync -a --progress /usr/lib/libc.so $LFS/usr/lib/ && \
    rsync -a --progress /usr/lib/crt*.o $LFS/usr/lib/ 2>/dev/null || true && \
    rsync -a --progress /usr/lib/mcrt*.o $LFS/usr/lib/ 2>/dev/null || true && \
    rsync -a --progress /usr/lib/Scrt*.o $LFS/usr/lib/ 2>/dev/null || true && \
    rsync -a --progress /usr/lib/rcrt*.o $LFS/usr/lib/ 2>/dev/null || true && \
    rsync -a --progress /usr/lib/gcrt*.o $LFS/usr/lib/ 2>/dev/null || true

# Copy build scripts
COPY scripts/full/ /build/scripts/
RUN chmod +x /build/scripts/*.sh

# ---- Stage 1: Download sources (optional, non-fatal) ----
RUN bash /build/scripts/download.sh || true

# ---- Stage 2: Build from source (skips missing tarballs) ----
RUN bash /build/scripts/build-all.sh

# ---- Stage 3: System configuration ----
RUN bash /build/scripts/configure.sh

# (Stripping and cleaning omitted for brevity, but you can keep as before)

FROM scratch
COPY --from=builder /lfs /
